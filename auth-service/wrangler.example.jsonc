{
  "name": "orbit-workbench-auth",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://17671052998-art.github.io"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "orbit-workbench-accounts",
    "database_id": "REPLACE_WITH_CREATED_D1_ID",
    "migrations_dir": "migrations"
  }]
}
